# Пример файла переменных окружения.
# На сервере скопируйте его в .env и заполните реальными значениями:
#   cp .env.example .env && nano .env
# Файл .env в репозиторий НЕ попадает (см. .gitignore) — там лежат секреты.

# --- Django ---------------------------------------------------------------
# Секретный ключ. Сгенерировать новый:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# 0 — продакшен (обязательно), 1 — режим разработки
DJANGO_DEBUG=0

# Домены через запятую, с которых разрешено обслуживать сайт
DJANGO_ALLOWED_HOSTS=example.ru,www.example.ru

# --- База данных PostgreSQL ----------------------------------------------
USE_POSTGRES=1
POSTGRES_DB=sinoptik
POSTGRES_USER=sinoptik_user
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Внешние сервисы ------------------------------------------------------
# Ключ OpenWeatherMap: слой осадков на карте и подстановка погоды в форму.
# Получить бесплатно: https://home.openweathermap.org/api_keys
OWM_API_KEY=

# --- Авторизация через VK ID ---------------------------------------------
# Кабинет разработчика: https://id.vk.com/about/business
# Redirect URI указывать так: https://ваш-домен.ru/auth/vk/login/callback/
VK_CLIENT_ID=
VK_SECRET=

# --- Celery ---------------------------------------------------------------
# 0 — задачи выполняются фоново через Redis (продакшен)
# 1 — синхронно, без брокера (разработка)
CELERY_EAGER=0
CELERY_BROKER_URL=redis://localhost:6379/0

# --- Реквизиты оператора персональных данных (152-ФЗ) ---------------------
# Выводятся на странице /privacy/
PDN_OPERATOR_NAME=
PDN_OPERATOR_CONTACT=
PDN_POLICY_UPDATED=
